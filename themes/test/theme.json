{
  "name": "My Theme",
  "author": "Kino",
  "version": 1,
  "colors": {
    "bg": "#000040",
    "fg": "#FF0000",
    "accent": "#00FF00",
    "accent2": "#FF0000",
    "muted": "#FF8040",
    "warn": "#FF8040"
  },
  "warnAbove": {
    "cpu.load": 95,
    "cpu.temp": 85,
    "mem.pct": 90
  },
  "pages": [
    {
      "name": "Page 1",
      "widgets": [
        {
          "type": "text",
          "x": 40,
          "y": 60,
          "text": "CPU",
          "size": "sm",
          "color": "muted"
        },
        {
          "type": "text",
          "x": 40,
          "y": 120,
          "bind": "cpu.load",
          "fmt": "{v:.0f}%",
          "size": "xl"
        },
        {
          "type": "bar",
          "x": 40,
          "y": 320,
          "w": 920,
          "h": 50,
          "bind": "cpu.load"
        },
        {
          "type": "text",
          "x": 140,
          "y": 410,
          "bind": "gpu.name",
          "fmt": "{v:.0f}%"
        },
        {
          "type": "chart",
          "x": 150,
          "y": 510,
          "w": 800,
          "h": 400,
          "bind": "gpu.load"
        },
        {
          "type": "text",
          "x": 40,
          "y": 420,
          "fmt": "{v:.0f}",
          "text": "GPU",
          "size": "sm",
          "color": "muted"
        },
        {
          "type": "text",
          "x": 130,
          "y": 50,
          "bind": "cpu.name",
          "fmt": "{v:.0f}%"
        },
        {
          "type": "text",
          "x": 670,
          "y": 930,
          "bind": "net.ip",
          "fmt": "{v:.0f}"
        },
        {
          "type": "arc",
          "x": 80,
          "y": 570,
          "r": 70,
          "anchor": "mc",
          "bind": "gpu.load",
          "thickness": 40,
          "label": true
        },
        {
          "type": "text",
          "x": 140,
          "y": 930,
          "bind": "host",
          "fmt": "{v:.0f}"
        },
        {
          "type": "image",
          "x": 690,
          "y": 30,
          "w": 240,
          "src": "vvs.png"
        }
      ]
    },
    {
      "name": "Page 2",
      "widgets": [
        {
          "type": "text",
          "x": 30,
          "y": 80,
          "bind": "net.if",
          "fmt": "{v:.0f}"
        }
      ]
    }
  ]
}